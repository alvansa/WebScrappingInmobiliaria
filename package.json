{
  "name": "app-remates",
  "version": "1.0.0",
  "description": "Aplicacion para la busqueda y entrega de resumen de remates",
  "main": "src/electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:test": "electron . --test",
    "check:case": "node scripts/check-case-sensitivity.js",
    "make": "npm run check:case && electron-builder",
    "makeMac": "npm run check:case && electron-builder --mac",
    "makeWindows": "npm run check:case && electron-builder --win --x64",
    "postinstall": "electron-rebuild",
    "dev": "electron . --dev",
    "empty": "electron . --empty",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:functional": "jest tests/Funcional",
    "app:dir": "electron-builder --dir",
    "commandsinfo": "node scripts/help.js",
    "lint": "eslint ."
  },
  "imports": {
    "#sources/*": "./src/core/sources/*",
    "#enrichers/*": "./src/core/enrichers/*",
    "#exporters/*": "./src/core/exporters/*",
    "#core/*": "./src/core/*",
    "#utils/*": "./utils/*",
    "#models/*": "./src/models/*",
    "#config": "./config/config.js",
    "#src/*": "./src/*"
  },
  "author": "Alvaro Soto",
  "type": "commonjs",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.4"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.7",
    "googleapis": "^105.0.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "joi": "^18.0.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-core": "^24.4.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-in-electron": "^3.0.5",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.AFInmobiliaria.InfoRemates",
    "productName": "InfoRemates",
    "directories": {
      "output": "out"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "extraResources": [
      {
        "from": "./src/core/enrichers/spreadSheet/credentials.json",
        "to": "credentials.json",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ]
  }
}
